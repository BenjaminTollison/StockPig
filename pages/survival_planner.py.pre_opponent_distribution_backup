def _table_html(df: pd.DataFrame) -> str:
    return df.to_html(
        index=False,
        border=0,
        classes="report-table",
        justify="left",
    )


def build_print_report(
    season: int,
    planning_start_week: int,
    goal_week: int,
    lookback_games: int,
    already_used_names: list[str],
    rankings: pd.DataFrame,
