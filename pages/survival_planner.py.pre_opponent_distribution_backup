def build_recommended_pick_score_charts(
    probabilities: pd.DataFrame,
    plan: list[tuple[int, tuple[int, ...]]],
    bundle: predictor.ModelBundle,
    planning_start_week: int,
) -> list[dict]:
    # Same residual Monte Carlo + score_distribution path as score_predictor_gpu.
    selected_ids: tuple[int, ...] | None = None
    for week, team_ids in plan:
        if int(week) == int(planning_start_week):
            selected_ids = tuple(int(team_id) for team_id in team_ids)
            break

    if not selected_ids:
        return []

    lookup = probabilities.set_index(["week", "team_id"], drop=False)
    charts: list[dict] = []

    for team_id in selected_ids:
        row = lookup.loc[(int(planning_start_week), int(team_id))]
        if isinstance(row, pd.DataFrame):
            row = row.iloc[0]

        if str(row["location"]) == "Home":
            expected_home = float(row["expected_points"])
            expected_away = float(row["opponent_expected_points"])
            recommended_is_home = True
            matchup_label = f'{row["opponent"]} @ {row["team"]}'
        else:
            expected_home = float(row["opponent_expected_points"])
            expected_away = float(row["expected_points"])
            recommended_is_home = False
            matchup_label = f'{row["team"]} @ {row["opponent"]}'

        game_id = int(row["game_id"])
        home_scores, away_scores = predictor.simulate_game_from_residuals(
            expected_home=expected_home,
            expected_away=expected_away,
            bundle=bundle,
            n=int(SCORE_GRAPH_MONTE_CARLO_SIMS),
            seed=(
                predictor.RANDOM_SEED
                + int(planning_start_week) * 10_007
                + game_id % 100_000
            ),
        )

        selected_scores = home_scores if recommended_is_home else away_scores
        distribution = predictor.score_distribution(selected_scores)
        p10 = predictor.score_percentile(selected_scores, 10)
        p90 = predictor.score_percentile(selected_scores, 90)

        charts.append(
            {
                "team_id": int(team_id),
                "team": str(row["team"]),
                "opponent": str(row["opponent"]),
                "location": str(row["location"]),
                "matchup": matchup_label,
                "expected_score": float(row["expected_points"]),
                "win_probability": float(row["win_probability"]),
                "p10": float(p10),
                "p90": float(p90),
                "distribution": distribution.reset_index(drop=True),
            }
        )

        del selected_scores
        del home_scores
        del away_scores

    gc.collect()
    try:
        if predictor.torch is not None and predictor.torch.cuda.is_available():
            predictor.torch.cuda.empty_cache()
    except Exception:
        pass

    return charts


def _score_distribution_svg(chart: dict) -> str:
    # Compact print-safe SVG generated from the same distribution shown in Streamlit.
    distribution = chart["distribution"].copy()
    if distribution.empty:
        return "<p>No simulated score distribution is available.</p>"

    distribution["Score"] = pd.to_numeric(
        distribution["Score"], errors="coerce"
    )
    distribution["Probability"] = pd.to_numeric(
        distribution["Probability"], errors="coerce"
    )
    distribution = distribution.dropna().sort_values("Score")
    if distribution.empty:
        return "<p>No simulated score distribution is available.</p>"

    scores = distribution["Score"].to_numpy(dtype=float)
    probabilities = distribution["Probability"].to_numpy(dtype=float)

    width = 760.0
    height = 250.0
    left = 46.0
    right = 12.0
    top = 16.0
    bottom = 38.0
    plot_width = width - left - right
    plot_height = height - top - bottom

    score_min = float(scores.min())
    score_max = float(scores.max())
    score_span = max(score_max - score_min + 1.0, 1.0)
    max_probability = max(float(probabilities.max()), 1e-9)

    bar_width = max(plot_width / score_span * 0.82, 1.0)
    bars = []
    for score, probability in zip(scores, probabilities):
        x = left + ((float(score) - score_min) / score_span) * plot_width
        bar_height = (float(probability) / max_probability) * plot_height
        y = top + plot_height - bar_height
        bars.append(
            f'<rect x="{x:.2f}" y="{y:.2f}" width="{bar_width:.2f}" '
            f'height="{bar_height:.2f}" fill="#4c78a8" />'
        )

    tick_values = []
    start_tick = int(math.floor(score_min / 10.0) * 10)
    end_tick = int(math.ceil(score_max / 10.0) * 10)
    for value in range(start_tick, end_tick + 1, 10):
        if score_min <= value <= score_max:
            tick_values.append(value)
    if not tick_values:
        tick_values = [int(round(score_min)), int(round(score_max))]
    tick_values = sorted(set(tick_values))

    x_ticks = []
    for value in tick_values:
        x = left + ((float(value) - score_min) / score_span) * plot_width
        x_ticks.append(
            f'<line x1="{x:.2f}" y1="{top + plot_height:.2f}" '
            f'x2="{x:.2f}" y2="{top + plot_height + 4:.2f}" '
            f'stroke="#444" stroke-width="1" />'
            f'<text x="{x:.2f}" y="{height - 12:.2f}" '
            f'text-anchor="middle" font-size="11">{value}</text>'
        )

    y_ticks = []
    for fraction in (0.0, 0.5, 1.0):
        probability = max_probability * fraction
        y = top + plot_height - fraction * plot_height
        y_ticks.append(
            f'<line x1="{left - 4:.2f}" y1="{y:.2f}" '
            f'x2="{width - right:.2f}" y2="{y:.2f}" '
            f'stroke="#ddd" stroke-width="1" />'
            f'<text x="{left - 7:.2f}" y="{y + 4:.2f}" '
            f'text-anchor="end" font-size="10">{100 * probability:.1f}%</text>'
        )

    team = html.escape(str(chart["team"]))
    opponent = html.escape(str(chart["opponent"]))
    relation = "vs" if str(chart["location"]) == "Home" else "@"

    return (
        f'<div class="score-chart-block">'
        f'<h3>{team} simulated score distribution</h3>'
        f'<p class="muted">{team} {relation} {opponent} &nbsp;|&nbsp; '
        f'Expected {float(chart["expected_score"]):.1f} &nbsp;|&nbsp; '
        f'Win {100 * float(chart["win_probability"]):.1f}% &nbsp;|&nbsp; '
        f'80% range {float(chart["p10"]):.0f}–{float(chart["p90"]):.0f}</p>'
        f'<svg viewBox="0 0 {int(width)} {int(height)}" '
        f'role="img" aria-label="{team} simulated score distribution">'
        + "".join(y_ticks)
        + "".join(bars)
        + f'<line x1="{left:.2f}" y1="{top + plot_height:.2f}" '
          f'x2="{width - right:.2f}" y2="{top + plot_height:.2f}" '
          f'stroke="#444" stroke-width="1" />'
        + "".join(x_ticks)
        + f'<text x="{left + plot_width / 2:.2f}" y="{height - 1:.2f}" '
          f'text-anchor="middle" font-size="11">Simulated team score</text>'
        + "</svg></div>"
    )


def _recommended_score_charts_html(charts: list[dict]) -> str:
    if not charts:
        return "<p>No recommended-pick score charts are available.</p>"

    rendered = "".join(_score_distribution_svg(chart) for chart in charts)
    return f'<div class="score-chart-grid">{rendered}</div>'


